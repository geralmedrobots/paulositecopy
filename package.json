{
  "name": "medrobots-website",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir .prerender && node scripts/prerender.mjs",
    "lint": "oxlint src scripts tests vite.config.js playwright.config.js --deny-warnings",
    "preview": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "format": "prettier --write src scripts tests *.js *.html",
    "audit:site": "node scripts/audit.mjs",
    "qa:visual": "node scripts/visual-qa.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.8",
    "vite": "^8.3.0"
  }
}
